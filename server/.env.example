# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# --- Game tuning (all optional) ---
MAX_PLAYERS_PER_ROOM=8
DEFAULT_ROUNDS=3
TURN_DURATION_SECONDS=80
# How long a disconnected player keeps their seat before being removed
RECONNECT_GRACE_SECONDS=30
# Rooms with nobody connected are deleted after this long
EMPTY_ROOM_TTL_SECONDS=60

# --- LiveKit voice (optional: leave blank to disable voice) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Token lifetime in seconds
LIVEKIT_TOKEN_TTL_SECONDS=600
